#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer"]
# ///
"""GitHub PR 的檢查與受保護合併命令。

預設只執行完整檢查並輸出四碼 confirmation hash；只有
`--apply <hash>` 在重新檢查並驗證 hash 通過後才執行 merge
(預設使用 `--squash` 策略)。
`--list` / `--resolve` 僅處理 review threads，不等待也不合併。
"""

import hashlib
import json
import re
import subprocess
import sys
import time
from datetime import datetime
from typing import Annotated, Any, Mapping
from urllib.parse import urlparse

import typer

# 視為 "失敗" 的 CheckRun conclusion; 其餘 (NEUTRAL/SKIPPED/STALE/SUCCESS) 視為通過。
FAILURE_CONCLUSIONS = {
    "FAILURE",
    "TIMED_OUT",
    "STARTUP_FAILURE",
    "CANCELLED",
    "ACTION_REQUIRED",
}

# 評論摘要顯示長度上限
BODY_SUMMARY_LEN = 120

THREADS_QUERY = """
query($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $cursor) {
        pageInfo {
          hasNextPage
          endCursor
        }
        nodes {
          id
          isResolved
          isOutdated
          path
          line
          comments(first: 1) {
            nodes {
              author { login }
              body
            }
          }
        }
      }
    }
  }
}
"""

RESOLVE_MUTATION = """
mutation($threadId: ID!) {
  resolveReviewThread(input: {threadId: $threadId}) {
    thread { id isResolved }
  }
}
"""


# ---- 純函式 (可測試的契約) ----

def confirmation_hash(updated_at: str) -> str:
    """以 updated_at 產生 4 字符確認碼, 防止 agent 憑印象執行 --apply。

    usedforsecurity=False 表示這裡不是安全用途, 只是變更偵測碼。
    """
    return hashlib.md5(
        updated_at.encode(), usedforsecurity=False
    ).hexdigest()[:4]


def fast_mergeability_error(view: Mapping[str, Any]) -> str | None:
    """快速篩選已可確認失敗的 PR (closed / draft / 確認衝突)。

    對於 CI 仍在跑 (BLOCKED/UNSTABLE/UNKNOWN/BEHIND 等) 一律視為可進入
    後續等待流程, 不在這裡拒絕。
    """
    if (view.get("state") or "").upper() != "OPEN":
        return f"PR 不是 OPEN 狀態: {view.get('state') or 'unknown'}"
    if view.get("isDraft"):
        return "PR 仍是 draft, 不能合併"
    if (view.get("mergeable") or "").upper() == "CONFLICTING":
        return "PR 存在已確認的合併衝突"
    if (view.get("mergeStateStatus") or "").upper() == "DIRTY":
        return "PR 的 mergeStateStatus 為 DIRTY, 存在合併衝突"
    return None


def final_mergeability_error(view: Mapping[str, Any]) -> str | None:
    """最終篩選: 確認 PR 已進入可合併狀態 (CLEAN/HAS_HOOKS + MERGEABLE)。"""
    if (error := fast_mergeability_error(view)) is not None:
        return error
    status = (view.get("mergeStateStatus") or "").upper()
    mergeable = (view.get("mergeable") or "").upper()
    if status not in {"CLEAN", "HAS_HOOKS"}:
        return f"PR 尚不可合併, mergeStateStatus={status or 'unknown'}"
    if mergeable != "MERGEABLE":
        return f"PR 尚不可合併, mergeable={mergeable or 'unknown'}"
    return None

def is_valid_confirmation_hash(value: str) -> bool:
    """確認碼格式檢查: 4 字符十六進位。"""
    return bool(re.fullmatch(r"[0-9a-f]{4}", value, re.IGNORECASE))


# ---- gh 呼叫 ----


def _run_gh(args: list[str], *, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, check=check)


def _gh_pr_view(pr: str | None, fields: str) -> dict:
    """呼叫 gh pr view --json 並回傳解析後的字典。"""
    cmd = ["gh", "pr", "view"]
    if pr:
        cmd.append(pr)
    cmd += ["--json", fields]
    try:
        r = _run_gh(cmd)
    except subprocess.CalledProcessError as e:
        stderr = (e.stderr or "").strip() or str(e)
        typer.secho(f"gh pr view 失敗: {stderr}", fg="red", err=True)
        raise typer.Exit(3) from e
    except OSError as e:
        detail = str(e).strip() or e.__class__.__name__
        typer.secho(f"gh pr view 失敗: {detail}", fg="red", err=True)
        raise typer.Exit(3) from e
    return json.loads(r.stdout)

def _parse_repo(url: str) -> tuple[str, str, int]:
    """從 PR URL 解析 (owner, repo, number)。

    URL 形如 https://github.com/owner/repo/pull/123
    """
    parts = urlparse(url).path.strip("/").split("/")
    if len(parts) < 4 or parts[2] != "pull":
        raise typer.Exit(f"無法解析 PR URL: {url}")
    return parts[0], parts[1], int(parts[3])


def _gh_graphql(query: str, **variables) -> dict:
    """呼叫 gh api graphql 並回傳解析後的字典。"""
    args = ["gh", "api", "graphql", "-f", f"query={query}"]
    for k, v in variables.items():
        value = "null" if v is None else v
        args += ["-F", f"{k}={value}"]
    try:
        r = _run_gh(args)
    except subprocess.CalledProcessError as e:
        stderr = (e.stderr or "").strip() or str(e)
        typer.secho(f"gh api graphql 失敗: {stderr}", fg="red", err=True)
        raise typer.Exit(3) from e
    except OSError as e:
        detail = str(e).strip() or e.__class__.__name__
        typer.secho(f"gh api graphql 失敗: {detail}", fg="red", err=True)
        raise typer.Exit(3) from e

    try:
        payload = json.loads(r.stdout)
    except (TypeError, json.JSONDecodeError) as e:
        detail = str(e).strip() or e.__class__.__name__
        typer.secho(
            f"gh api graphql 回應不是有效 JSON: {detail}",
            fg="red",
            err=True,
        )
        raise typer.Exit(3) from e
    if not isinstance(payload, dict):
        typer.secho("gh api graphql 回應格式錯誤: 頂層不是 object", fg="red", err=True)
        raise typer.Exit(3)
    if payload.get("errors"):
        details = json.dumps(payload["errors"], ensure_ascii=False)
        typer.secho(f"gh api graphql 回應含 errors: {details}", fg="red", err=True)
        raise typer.Exit(3)
    return payload


# ---- CI 判讀 ----


def _summarise_checks(rollup: list[dict]) -> tuple[str, bool, bool, bool]:
    """回傳 (摘要字串, 全部完成, 全部成功, 已知失敗)。

    「已知失敗」在還沒全部完成時就可能為 True, 用於 fail-fast: 任何一個
    檢查項已結論為失敗就立即退出, 不必等其他檢查跑完。
    """
    if not rollup:
        return "no checks", True, True, False

    total = len(rollup)
    done = 0
    fail = 0

    for check in rollup:
        if check.get("__typename") == "StatusContext":
            state = (check.get("state") or "").upper()
            if state in {"SUCCESS", "FAILURE", "ERROR"}:
                done += 1
                if state != "SUCCESS":
                    fail += 1
        else:
            if check.get("status") == "COMPLETED":
                done += 1
                if (check.get("conclusion") or "").upper() in FAILURE_CONCLUSIONS:
                    fail += 1

    summary = f"{done}/{total} done"
    if fail:
        summary += f", {fail} fail"
    return summary, done == total, done == total and fail == 0, fail > 0


# ---- review threads ----


def _graphql_object(value: Any, path: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        typer.secho(
            f"gh api graphql 回應缺少或無效 {path}",
            fg="red",
            err=True,
        )
        raise typer.Exit(3)
    return value


def _graphql_shape_error(path: str) -> None:
    typer.secho(
        f"gh api graphql 回應缺少或無效 {path}",
        fg="red",
        err=True,
    )
    raise typer.Exit(3)


def _fetch_threads(owner: str, name: str, number: int) -> list[dict]:
    """取得 PR 的 review threads (含已解決與未解決), 並聚合所有分頁。"""
    nodes: list[dict] = []
    cursor: str | None = None

    while True:
        payload = _gh_graphql(
            THREADS_QUERY,
            owner=owner,
            name=name,
            number=number,
            cursor=cursor,
        )
        payload = _graphql_object(payload, "response")
        data = _graphql_object(payload.get("data"), "data")
        repository = _graphql_object(data.get("repository"), "repository")
        pull_request = _graphql_object(
            repository.get("pullRequest"), "repository.pullRequest"
        )
        connection = _graphql_object(
            pull_request.get("reviewThreads"), "repository.pullRequest.reviewThreads"
        )

        page_nodes = connection.get("nodes")
        if not isinstance(page_nodes, list):
            _graphql_shape_error("repository.pullRequest.reviewThreads.nodes")
        for node_index, node in enumerate(page_nodes):
            node_path = (
                "repository.pullRequest.reviewThreads"
                f".nodes[{node_index}]"
            )
            if not isinstance(node, dict):
                _graphql_shape_error(node_path)
            comments = node.get("comments")
            if not isinstance(comments, dict):
                _graphql_shape_error(f"{node_path}.comments")
            comment_nodes = comments.get("nodes")
            if not isinstance(comment_nodes, list):
                _graphql_shape_error(f"{node_path}.comments.nodes")
            for comment_index, comment in enumerate(comment_nodes):
                if not isinstance(comment, dict):
                    _graphql_shape_error(
                        f"{node_path}.comments.nodes[{comment_index}]"
                    )

        page_info = connection.get("pageInfo")
        if not isinstance(page_info, dict):
            _graphql_shape_error("repository.pullRequest.reviewThreads.pageInfo")
        if "hasNextPage" not in page_info or "endCursor" not in page_info:
            _graphql_shape_error("repository.pullRequest.reviewThreads.pageInfo")

        nodes.extend(page_nodes)
        if not page_info["hasNextPage"]:
            return nodes
        cursor = page_info["endCursor"]
        if not cursor:
            typer.secho("reviewThreads 分頁缺少 endCursor", fg="red", err=True)
            raise typer.Exit(3)


def _thread_location(thread: dict) -> str:
    path = thread.get("path") or "?"
    line = thread.get("line")
    if line is None:
        return path
    return f"{path}:{line}"


def _thread_author(thread: dict) -> str:
    comments = thread.get("comments", {}).get("nodes", []) or []
    if not comments:
        return "?"
    author = comments[0].get("author") or {}
    return author.get("login") or "?"


def _thread_body_summary(thread: dict) -> str:
    comments = thread.get("comments", {}).get("nodes", []) or []
    body = (comments[0].get("body") or "").strip() if comments else ""
    # 取第一行, 截斷
    first_line = body.splitlines()[0] if body else ""
    if len(first_line) > BODY_SUMMARY_LEN:
        first_line = first_line[: BODY_SUMMARY_LEN - 1] + "…"
    return first_line


def _print_threads(
    threads: list[dict], *, only_unresolved: bool = True, pr: str | None = None
) -> list[dict]:
    """印出 review threads, 回傳實際顯示的 (未解決) threads 清單。"""
    shown = [t for t in threads if not (only_unresolved and t.get("isResolved"))]
    if not shown:
        typer.secho("沒有未解決的 review threads", fg="green")
        return shown

    typer.secho(
        f"\n未解決 review threads ({len(shown)}):", fg="cyan", bold=True
    )
    for idx, t in enumerate(shown, start=1):
        loc = _thread_location(t)
        author = _thread_author(t)
        tid = t.get("id", "?")
        outdated = " (outdated)" if t.get("isOutdated") else ""
        typer.echo(f"  [{idx}] {loc}  {author}{outdated}")
        typer.secho(f"      {tid}", fg="bright_black")
        summary = _thread_body_summary(t)
        if summary:
            typer.echo(f"      {summary}")

    resolve_hint = "pr_merge"
    if pr:
        resolve_hint += f" --pr {pr}"

    typer.secho(
        f"\n解決: {resolve_hint} --resolve '#1'  (索引, 可逗號分隔) 或 --resolve {shown[0].get('id','<ID>')}",
        fg="bright_black",
    )
    return shown


def _resolve_thread(thread_id: str) -> bool:
    """解決一個 review thread, 回傳是否成功。"""
    try:
        _gh_graphql(RESOLVE_MUTATION, threadId=thread_id)
    except typer.Exit as exc:
        if getattr(exc, "exit_code", None) == 3:
            raise
        return False
    return True


def _expand_resolve_ids(
    raw: list[str], owner: str, name: str, number: int
) -> list[str]:
    """將 --resolve 的輸入展開為完整 thread ID 清單。

    支援: 完整 thread ID, 或 #N 索引 (以當前未解決 threads 的顯示順序為準)。
    輸入可重複或以逗號分隔。
    """
    tokens: list[str] = []
    for r in raw:
        tokens.extend(x.strip() for x in r.split(",") if x.strip())

    if not tokens:
        return []

    indices: list[int] = []
    ids: list[str] = []
    for tok in tokens:
        if tok.startswith("#"):
            try:
                indices.append(int(tok[1:]))
            except ValueError:
                typer.secho(f"無效的索引: {tok}", fg="red", err=True)
                raise typer.Exit(3)
        else:
            ids.append(tok)

    if indices:
        threads = _fetch_threads(owner, name, number)
        unresolved = [t for t in threads if not t.get("isResolved")]
        for n in indices:
            if n < 1 or n > len(unresolved):
                typer.secho(
                    f"索引 #{n} 超出範圍 (未解決 threads 共 {len(unresolved)})",
                    fg="red",
                    err=True,
                )
                raise typer.Exit(3)
            ids.append(unresolved[n - 1].get("id"))

    return ids


# ---- 主流程 ----


def _wait(
    pr: str | None,
    timeout: int,
    interval: int,
    initial_view: dict | None = None,
) -> dict:
    """輪詢等待 CI 完成。

    回傳 pr_view_data。若 caller 已有包含 statusCheckRollup 的初始 view,
    首輪直接使用它。
    """
    deadline = time.time() + timeout
    printed_header = False
    first_iteration = True

    data: dict | None = initial_view

    while True:
        if data is None:
            data = _gh_pr_view(
                pr, "statusCheckRollup,number,url,headRefName,baseRefName"
            )

        if not printed_header:
            number = data.get("number")
            url = data.get("url")
            head = data.get("headRefName") or "?"
            base = data.get("baseRefName") or "?"
            typer.echo(f"PR #{number} → {url}")
            typer.echo(f"分支: {head} → {base}")
            printed_header = True

        rollup = data.get("statusCheckRollup") or []

        ci_summary, ci_done, _, ci_failed = _summarise_checks(rollup)

        # 首輪看到空 rollup 不信: GitHub 可能還沒把 CI 註冊進來。
        if first_iteration and not rollup:
            ci_done = False
            ci_summary = "registering…"
        first_iteration = False

        ts = datetime.now().strftime("%H:%M:%S")
        typer.echo(f"[{ts}] CI: {ci_summary}")

        # fail-fast: CI 任一項已失敗, 立即退出, 不必等其他檢查。
        if ci_failed:
            typer.secho(f"CI: {ci_summary}", fg="red", err=True)
            raise typer.Exit(1)

        if ci_done:
            break

        if time.time() >= deadline:
            typer.secho(f"⏱ 超時 ({timeout}s), 停止等待", fg="yellow", err=True)
            raise typer.Exit(2)

        time.sleep(min(interval, max(0, deadline - time.time())))
        data = None

    return data


# 初始 gh pr view 抓的欄位: 解析目標 + fast mergeability 篩選所需。
_FAST_VIEW_FIELDS = (
    "number,url,state,isDraft,headRefName,baseRefName,"
    "mergeStateStatus,mergeable,updatedAt,statusCheckRollup"
)
# final 篩選用的欄位: 加上 updatedAt 以計算確認碼。
_FINAL_VIEW_FIELDS = (
    "number,url,state,isDraft,headRefName,baseRefName,"
    "mergeStateStatus,mergeable,updatedAt"
)
def _format_apply_command(
    *,
    target: str,
    apply_hash: str,
    delete_branch: bool,
) -> str:
    """組成可直接交給 CLI 的「pr_merge --apply <hash> --user-agreed --pr <target>」範例。"""
    parts = ["pr_merge", "--apply", apply_hash, "--user-agreed"]
    if delete_branch:
        parts.append("--delete-branch")
    parts.extend(["--pr", target])
    return " ".join(parts)


def _run_check(
    pr: str | None,
    *,
    timeout: int,
    interval: int,
    owner: str,
    name: str,
    number: int,
) -> dict[str, Any]:
    """執行完整檢查流程, 回傳 final view (含 updatedAt) 以便計算 hash。

    任一階段失敗 (fast screening / CI fail-fast / threads / final screening)
    都會以 typer.Exit 離開, 不會回到 caller。
    """
    fast_view = _gh_pr_view(pr, _FAST_VIEW_FIELDS)
    err = fast_mergeability_error(fast_view)
    if err is not None:
        typer.secho(f"✗ {err}", fg="red", err=True)
        typer.echo(
            f"提示: 直接執行 {pr or '當前分支的 PR'} 不會通過 fast screening",
            err=True,
        )
        raise typer.Exit(1)

    # _wait 內部已處理 CI fail-fast。
    _wait(pr, timeout, interval, initial_view=fast_view)

    # threads 檢查
    threads = _fetch_threads(owner, name, number)
    unresolved = [t for t in threads if not t.get("isResolved")]
    _print_threads(threads, pr=pr)
    if unresolved:
        typer.secho(
            f"✗ 仍有 {len(unresolved)} 個未解決 review threads, 不可 merge",
            fg="red",
            err=True,
        )
        raise typer.Exit(1)

    # final 重查 mergeStateStatus/mergeable/updatedAt
    final_view = _gh_pr_view(pr, _FINAL_VIEW_FIELDS)
    err = final_mergeability_error(final_view)
    if err is not None:
        typer.secho(f"✗ {err}", fg="red", err=True)
        typer.echo(
            "提示: PR 尚未進入可合併狀態; 請先解決衝突或等待 CI 跑完",
            err=True,
        )
        raise typer.Exit(1)

    return final_view


def main(
    pr: Annotated[
        str | None,
        typer.Option("--pr", help="PR 編號或 URL (省略則用當前分支的 PR)"),
    ] = None,
    timeout: Annotated[
        int,
        typer.Option("--timeout", help="超時秒數"),
    ] = 15 * 60,
    interval: Annotated[
        int,
        typer.Option("--interval", help="輪詢間隔秒數"),
    ] = 30,
    list_only: Annotated[
        bool,
        typer.Option(
            "--list",
            help="只列出 review threads, 不等待 CI",
        ),
    ] = False,
    resolve: Annotated[
        list[str] | None,
        typer.Option(
            "--resolve",
            help="解決 review thread (完整 thread ID 或 #N 索引; 可重複或逗號分隔)",
        ),
    ] = None,
    apply_hash: Annotated[
        str | None,
        typer.Option(
            "--apply",
            help="重驗證後依四碼確認碼執行 merge (必須同時帶 --user-agreed)",
        ),
    ] = None,
    check_only: Annotated[
        bool,
        typer.Option(
            "--check",
            help="語意旗標: 預設行為即為完整檢查, 加此旗標只為讓意圖明確 (無功能)",
        ),
    ] = False,
    user_agreed: Annotated[
        bool,
        typer.Option(
            "--user-agreed",
            help="語意旗標: 確認使用者已授權 --apply 執行 merge (必須與 --apply 同時使用, 無功能)",
        ),
    ] = False,
    delete_branch: Annotated[
        bool,
        typer.Option(
            "--delete-branch",
            help="merge 後刪除本地與遠端 branch",
        ),
    ] = False,
) -> None:
    """等待 PR 的 CI 完成, 列出 review threads, 並在確認後執行 merge。

    預設使用當前分支的 PR, 每 --interval 秒輪詢一次。預設只檢查並輸出
    確認碼; 只有 --apply <hash> 通過同樣重驗證後才會真正呼叫 gh pr merge。

    退出碼:
      0  檢查通過 (apply 模式時含 merge 成功)
      1  CI / threads / mergeability 任一項失敗, 或 --apply hash 不符
      2  超時
      3  gh CLI 錯誤 (例如當前分支沒有 PR, 或 gh 未安裝),
         或 --apply 未帶 --user-agreed
    """
    # 取得 PR 基本資訊 (resolve / list / 預設流程都需要)
    view = _gh_pr_view(pr, "number,url")
    owner, name, number = _parse_repo(view.get("url", ""))
    target = view.get("url") or (pr or "")

    # --apply / --list / --resolve 互斥。
    modes = [apply_hash is not None, bool(list_only), resolve is not None]
    if sum(modes) > 1:
        typer.secho(
            "--apply / --list / --resolve 互斥, 不可同時指定",
            fg="red",
            err=True,
        )
        raise typer.Exit(3)

    # --apply 必須同時帶 --user-agreed 才能通過。
    if apply_hash is not None and not user_agreed:
        typer.secho(
            "✗ --apply 必須同時指定 --user-agreed (語意旗標, 確認使用者已授權 merge)",
            fg="red",
            err=True,
        )
        typer.echo(
            f"請改用: pr_merge --apply <hash> --user-agreed --pr {target}",
            err=True,
        )
        raise typer.Exit(3)

    # --resolve 模式: 解決指定 threads 後離開, 不等待。
    if resolve is not None:
        ids = _expand_resolve_ids(resolve, owner, name, number)
        if not ids:
            typer.secho("未提供任何 thread ID", fg="red", err=True)
            raise typer.Exit(3)
        ok = 0
        for tid in ids:
            if _resolve_thread(tid):
                typer.secho(f"✓ 已解決 {tid}", fg="green")
                ok += 1
            else:
                typer.secho(f"✗ 解決失敗 {tid}", fg="red", err=True)
        typer.echo(f"已解決 {ok}/{len(ids)} 個 thread")
        raise typer.Exit(0 if ok == len(ids) else 1)

    # --list 模式: 直接列出 threads, 不等待。
    if list_only:
        typer.echo(f"PR #{view.get('number')} → {view.get('url')}")
        threads = _fetch_threads(owner, name, number)
        _print_threads(threads, pr=pr)
        raise typer.Exit(0)

    # 預設 / --apply 模式: 跑完整檢查流程。
    final_view = _run_check(
        pr,
        timeout=timeout,
        interval=interval,
        owner=owner,
        name=name,
        number=number,
    )

    updated_at = final_view.get("updatedAt") or ""
    current_hash = confirmation_hash(updated_at)
    number_val = final_view.get("number")
    url_val = final_view.get("url")
    head = final_view.get("headRefName") or "?"
    base = final_view.get("baseRefName") or "?"

    typer.echo()
    typer.echo(f"PR #{number_val} → {url_val}")
    typer.echo(f"分支: {head} → {base}")
    typer.secho("PR 可合併", fg="green", bold=True)
    typer.echo(f"確認碼: {current_hash}")

    apply_cmd = _format_apply_command(
        target=target,
        apply_hash=current_hash,
        delete_branch=delete_branch,
    )
    typer.echo(f"執行: {apply_cmd}")

    if apply_hash is None:
        raise typer.Exit(0)

    # --apply 模式: 驗證 hash 並呼叫 gh pr merge。
    normalized = apply_hash.lower()
    if not is_valid_confirmation_hash(apply_hash):
        typer.secho(
            f"✗ --apply 參數需為 4 字符十六進位, 收到: {apply_hash!r}",
            fg="red",
            err=True,
        )
        typer.echo(f"請改用: {apply_cmd}")
        raise typer.Exit(1)
    if normalized != current_hash:
        typer.secho(
            "✗ 確認碼與當前 PR updatedAt 不符 (PR 可能剛更新); "
            "請重新執行 pr_merge 取得最新確認碼",
            fg="red",
            err=True,
        )
        typer.echo(f"請改用: {apply_cmd}")
        raise typer.Exit(1)

    # 組合 gh pr merge 指令: 目標 + 預設 --squash + (可選) --delete-branch。
    merge_cmd = ["gh", "pr", "merge", target, "--squash"]
    if delete_branch:
        merge_cmd.append("--delete-branch")
    try:
        _run_gh(merge_cmd)
    except subprocess.CalledProcessError as exc:
        diagnostics = [f"returncode={exc.returncode}"]
        stderr = (getattr(exc, "stderr", None) or "").strip()
        stdout = (getattr(exc, "stdout", None) or "").strip()
        if stderr:
            diagnostics.append(f"stderr: {stderr}")
        if stdout:
            diagnostics.append(f"stdout: {stdout}")
        if not stderr and not stdout:
            diagnostics.append(str(exc))
        typer.secho(
            f"gh pr merge 失敗: {'; '.join(diagnostics)}",
            fg="red",
            err=True,
        )
        raise typer.Exit(exc.returncode or 1) from exc
    except OSError as exc:
        detail = str(exc).strip() or exc.__class__.__name__
        typer.secho(f"gh pr merge 失敗: {detail}", fg="red", err=True)
        raise typer.Exit(3) from exc
    typer.secho(f"✓ 已送出 merge: {' '.join(merge_cmd)}", fg="green")
    raise typer.Exit(0)


if __name__ == "__main__":
    try:
        typer.run(main)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
