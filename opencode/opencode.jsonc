{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "autoupdate": true,
  "model": "opencode-go/muse-spark-1.3-contributor",
  "small_model": "opencode-go/muse-spark-1.3-contributor",
  "permission": {
    "bash": {
      "pkill -f *": "deny",
    },
    // 所有 agent 都可以委派 explore 來查詢資料, vision 來解釋圖片, 但其他 subagent 採用白名單
    "task": {
      "*": "deny",
      "explore": "allow",
      "vision": "allow",
    },
    "external_directory": {
      "/tmp/*": "allow"
    },
    // 僅主模型可使用記憶工具
    "memory_*": "deny",
    // 僅 @query agent 可使用網路搜尋工具
    "websearch_*": "deny",
    "websearch-fallback_*": "deny",
    "brave-search_*": "deny",
  },
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "formatStyle": "grouped",
      "percentDisplayMode": "used",
    },
  },
}
